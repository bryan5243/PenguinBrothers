[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="players"
2d_physics/layer_3="enemies"
2d_physics/layer_4="bombs"
2d_physics/layer_5="objects"
2d_physics/layer_6="platforms"
2d_physics/layer_7="hazards"
2d_physics/layer_8="pickups"

[physics]

2d/default_gravity=1750.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.16, 0.29, 1)
